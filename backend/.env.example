##############################################
# Express Backend
##############################################

# Port for local backend development.
PORT=4001
# Comma-separated allowed browser origins; use the Vercel origin in production.
CORS_ORIGINS=https://your-app.vercel.app
# Neon PostgreSQL connection string; configure a private real value in Render.
DATABASE_URL=your-neon-database-url-here
# Random JWT signing secret with at least 32 characters; keep private.
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Public frontend origin used for email verification and OAuth result links.
APP_BASE_URL=https://your-app.vercel.app
# Google OAuth client ID.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
# Google OAuth client secret; keep private.
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Exact Google OAuth callback URL registered with Google.
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/auth/oauth/google/callback
# Resend API key for verification mail; keep private.
RESEND_API_KEY=your-resend-api-key
# Sender identity used for verification mail.
RESEND_FROM_EMAIL=CollabKar <onboarding@yourdomain.com>

# Remaining authentication settings.
AUTH_JWT_EXPIRES_IN=7d
AUTH_PASSWORD_PEPPER=replace-with-a-private-random-value
AUTH_ALLOW_DEV_ADMIN_LOGIN=false
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_VERIFY_TOKEN_TTL_MIN=60
OAUTH_STATE_SECRET=replace-with-a-private-random-value
FACEBOOK_CLIENT_ID=your-facebook-oauth-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-oauth-client-secret
FACEBOOK_REDIRECT_URI=https://your-backend.onrender.com/api/auth/oauth/facebook/callback
APPLE_CLIENT_ID=your-apple-services-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PEM=your-apple-private-key-pem
APPLE_REDIRECT_URI=https://your-backend.onrender.com/api/auth/oauth/apple/callback

# Internal AI service settings.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=10000

# Scraper controls.
SCRAPER_BATCH_SIZE=50
SCRAPER_MAX_REQUESTS_PER_MIN=60
SCRAPER_LAST_SCRAPED_WINDOW_HOURS=24
SCRAPER_USERNAMES_SEED_FILE=./data/seed_usernames.txt

# Local model storage.
AI_MODELS_DIR=./data/models

# Optional external waitlist webhook.
WAITLIST_WEBHOOK_URL=
